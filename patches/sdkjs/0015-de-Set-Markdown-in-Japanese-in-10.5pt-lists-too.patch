From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yasuhiro Niji <aiseed-dev@users.noreply.github.com>
Date: Tue, 24 Nov 2026 14:00:49 +0900
Subject: [PATCH] [de] Set Markdown in Japanese, in 10.5pt, lists too

Markdown comes through the converter's HTML, which sets everything in
Arial (Japanese text too), in English with Chinese for East Asian text,
leaves the size of paragraphs to the editor's default (10pt) and gives
numbered and bullet lists the 12pt of its "normal" style. The desktop
app opens it as that docx, so the editor knows it by the .md of the
title. A Markdown file opened here is Japanese: its styles get Japanese
as the language and BIZ UDGothic for East Asian text, and 10.5pt is the
default size and that of the default paragraph style. Headings keep
their sizes, which their character styles give.
---
 word/api.js | 38 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/word/api.js b/word/api.js
index 957bd67..93919a0 100644
--- a/word/api.js
+++ b/word/api.js
@@ -1439,8 +1439,46 @@ background-repeat: no-repeat;\
 		g_oIdCounter.Set_Load(true);
 		AscFonts.IsCheckSymbols = true;
 	};
+	// Markdown comes through the converter's HTML, which sets everything in
+	// Arial (Japanese too), in English with Chinese for East Asian text, leaves
+	// the size of paragraphs to the editor's default (10pt) and gives lists the
+	// 12pt of its "normal" style. A Markdown file opened here is Japanese: set
+	// it in 10.5pt, in Japanese, with BIZ UDGothic for the Japanese text.
+	function SetMarkdownJapanese(logicDocument)
+	{
+		var styles = logicDocument.Styles;
+		var textPrs = [styles.Default.TextPr];
+		for (var id in styles.Style)
+			textPrs.push(styles.Style[id].TextPr);
+		textPrs.forEach(function(textPr)
+		{
+			if (textPr.RFonts.EastAsia)
+				textPr.RFonts.EastAsia = {Name : "BIZ UDゴシック", Index : -1};
+			if (undefined !== textPr.Lang.Val)
+				textPr.Lang.Val = lcid_jaJP;
+			if (undefined !== textPr.Lang.EastAsia)
+				textPr.Lang.EastAsia = lcid_jaJP;
+		});
+		var defaultTextPr = styles.Default.TextPr;
+		defaultTextPr.FontSize   = 10.5;
+		defaultTextPr.FontSizeCS = 10.5;
+		var normal = styles.Get(styles.Default.Paragraph);
+		if (normal)
+		{
+			normal.TextPr.FontSize   = 10.5;
+			normal.TextPr.FontSizeCS = 10.5;
+		}
+		logicDocument.GetAllParagraphs().forEach(function(paragraph)
+		{
+			paragraph.Recalc_CompiledPr();
+		});
+	}
 	function AfterOpenDocument(data, size)
 	{
+		// The desktop app opens Markdown as the docx the converter makes of it
+		if (/\.md$/i.test(this.documentTitle) && this.WordControl.m_oLogicDocument)
+			SetMarkdownJapanese(this.WordControl.m_oLogicDocument);
+
 		if (History && History.Update_FileDescription)
 			History.Update_FileDescription(data, size);
 

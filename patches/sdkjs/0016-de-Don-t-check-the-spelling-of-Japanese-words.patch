From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yasuhiro Niji <aiseed-dev@users.noreply.github.com>
Date: Wed, 25 Nov 2026 09:59:06 +0900
Subject: [PATCH] [de] Don't check the spelling of Japanese words

A word is checked in the language of its text (w:lang val), but there
is no dictionary for Japanese, and Japanese text is often marked with
another language, so every word of kana or kanji got a red line. Word
checks no spelling in Japanese. A word with kana, kanji or full-width
letters is not checked now; Korean and the rest are as before.

Assisted-by: ClaudeCode:claude-opus-5-5
---
 .../SpellChecker/ParagraphSpellChecker.js     | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/word/Editor/SpellChecker/ParagraphSpellChecker.js b/word/Editor/SpellChecker/ParagraphSpellChecker.js
index 5497905..fb5c47e 100644
--- a/word/Editor/SpellChecker/ParagraphSpellChecker.js
+++ b/word/Editor/SpellChecker/ParagraphSpellChecker.js
@@ -46,6 +46,20 @@
 		return AscCommon.IsDigit(code) || isHindiDigit(code) || (!!DIGITS[code]);
 	}
 	
+	// Kana, kanji and full-width letters: Japanese has no spelling to check
+	// (Word checks none), and there is no dictionary for it
+	function isJapanese(code)
+	{
+		return (0x3040 <= code && code <= 0x30FF)
+			|| (0x31F0 <= code && code <= 0x31FF)
+			|| (0x3400 <= code && code <= 0x4DBF)
+			|| (0x4E00 <= code && code <= 0x9FFF)
+			|| (0xF900 <= code && code <= 0xFAFF)
+			|| (0xFF10 <= code && code <= 0xFF5A)
+			|| (0xFF66 <= code && code <= 0xFF9F)
+			|| (0x20000 <= code && code <= 0x3134F);
+	}
+	
 	const IGNORE_UPPERCASE = 0x0001;
 	const IGNORE_NUMBERS   = 0x0002;
 
@@ -390,6 +404,12 @@
 		if (1 >= sWord.length || ((this.Flags & IGNORE_UPPERCASE) && AscCommon.IsAbbreviation(sWord)))
 			return false;
 
+		for (let iter = sWord.getUnicodeIterator(); iter.check(); iter.next())
+		{
+			if (isJapanese(iter.value()))
+				return false;
+		}
+
 		if (this.Flags & IGNORE_NUMBERS)
 		{
 			for (var oIterator = sWord.getUnicodeIterator(); oIterator.check(); oIterator.next())
